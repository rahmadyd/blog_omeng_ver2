---
import Base from './Base.astro';

interface Props {
  title: string;
  kind?: string;
  category?: 'project' | 'shop';
  role?: string;
  year?: number;
  summary?: string;
  image?: string;
  badges?: string[];
  price?: string;
  link?: string;
  client?: string;
  duration?: string;
  liveUrl?: string;
  repoUrl?: string;
}

const {
  title,
  category = 'project',
  role = 'Art Director & Software Engineer',
  year = 2024,
  summary,
  image = '/images/all-image-logo.png',
  badges = [],
  price,
  link = '6285777145179',
} = Astro.props;

const isShopItem = category === 'shop';
const cleanWa = link.replace(/[^0-9]/g, '');
const waNumber = cleanWa.startsWith('0') ? '62' + cleanWa.slice(1) : cleanWa;
const waMsg = encodeURIComponent(`Halo Omeng Creations! Saya tertarik untuk memesan produk "${title}". Apakah masih tersedia?`);
const waLink = `https://wa.me/${waNumber}?text=${waMsg}`;
---

<Base title={`${title} | Omeng Creations`} description={summary} ogImage={image}>
  <article class="detail-hero">
    <div class="detail-wrapper">
      <!-- Back Link Asli -->
      <a href={isShopItem ? '/shop' : '/myproject'} class="back-link">
        <span class="back-arrow" aria-hidden="true">←</span>
        <span>Kembali ke {isShopItem ? 'Katalog Toko' : 'Galeri Proyek'}</span>
      </a>

      <!-- Detail Container Asli (Grid 2 Kolom) -->
      <div class="detail-container">
        <!-- Gambar Utama dengan Lightbox Preview Trigger -->
        <div class="detail-image" data-preview data-title={title}>
          <img src={image} alt={title} width="800" height="600" />
          <span class="zoom-indicator">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
            Klik untuk Perbesar
          </span>
        </div>

        <!-- Konten & Metadata Asli -->
        <div class="detail-content">
          <!-- Badges -->
          <div class="detail-meta">
            {badges.map((b) => (
              <span class="badge">{b}</span>
            ))}
          </div>

          <!-- Judul Besar -->
          <h1 class="item-title">{title}</h1>

          <!-- Tag Harga (Jika Item Shop) -->
          {isShopItem && price && (
            <div class="price-container">
              <span class="price-tag">{price}</span>
            </div>
          )}

          <!-- Deskripsi Ringkas -->
          <p class="item-lead">{summary}</p>

          <!-- Aksi Pemesanan WhatsApp (Jika Shop Item) -->
          {isShopItem && (
            <div class="order-container">
              <a href={waLink} target="_blank" rel="noopener noreferrer" class="order-btn">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.044-1.014-.078-.242-.077-.552-.19-.942-.358-1.656-.714-2.733-2.38-2.816-2.49-.083-.11-.678-.901-.678-1.718 0-.817.428-1.218.58-1.383.153-.165.334-.206.446-.206.111 0 .223.001.32.006.102.005.239-.039.373.285.14.339.479 1.168.521 1.254.043.085.072.186.014.3-.058.115-.088.187-.175.289-.088.102-.185.228-.264.306-.089.088-.182.184-.078.362.103.179.46 0.758.988 1.228.679.605 1.251.792 1.43 0.881.179.089.284.075.39-.047.105-.122.45-.525.57-.704.12-.179.24-.15.4-.089.161.061 1.02.481 1.196.568.175.088.293.131.336.205.044.074.044.428-.1 0.833z"/>
                </svg>
                Pesan via WhatsApp
              </a>
            </div>
          )}

          <!-- Detail Teknis & Cerita Kasus (Markdown Slot) -->
          <div class="markdown-details">
            <slot />
          </div>

          <!-- Metadata Footer -->
          <div class="item-footer">
            <span class="publish-date">Dipublikasikan pada: {year}</span>
            <span class="role-badge">Peran: {role}</span>
          </div>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .detail-hero {
    padding: 40px 24px 80px;
    background: var(--color-primary-black);
  }

  .detail-wrapper {
    max-width: 1280px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary-pink);
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 24px;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .back-link:hover {
    color: #ffffff;
    transform: translateX(-4px);
  }

  .back-arrow {
    font-size: 1.2rem;
  }

  /* Grid 2 Kolom Asli */
  .detail-container {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 48px;
    align-items: start;
    background: rgba(255, 255, 255, 0.03);
    padding: clamp(24px, 4vw, 48px);
    border-radius: var(--radius-xl);
    border: 1px solid rgba(255, 192, 203, 0.15);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .detail-image {
    position: relative;
    cursor: zoom-in;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #111116;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .detail-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .detail-image:hover img {
    transform: scale(1.04);
  }

  .zoom-indicator {
    position: absolute;
    bottom: 16px;
    right: 16px;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    pointer-events: none;
    transition: background 0.2s ease;
  }

  .detail-image:hover .zoom-indicator {
    background: var(--color-accent);
  }

  .detail-content {
    display: flex;
    flex-direction: column;
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .badge {
    background: var(--color-primary-pink);
    color: #000000;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
  }

  .item-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    line-height: 0.95;
    color: var(--color-accent);
    margin-bottom: 16px;
    letter-spacing: 0.02em;
  }

  .price-container {
    margin-bottom: 20px;
  }

  .price-tag {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    display: inline-block;
  }

  .item-lead {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .order-container {
    margin-bottom: 32px;
  }

  .order-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25D366;
    color: #ffffff;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
  }

  .order-btn:hover {
    background: #1ebc59;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(37, 211, 102, 0.5);
  }

  /* Markdown Slot Styling */
  .markdown-details :global(h2) {
    font-family: var(--font-display);
    font-size: 2rem;
    color: #ffffff;
    margin-top: 24px;
    margin-bottom: 12px;
    letter-spacing: 0.03em;
    border-bottom: 1px solid rgba(255, 192, 203, 0.2);
    padding-bottom: 6px;
  }

  .markdown-details :global(p) {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin-bottom: 14px;
  }

  .markdown-details :global(ul) {
    padding-left: 20px;
    margin-bottom: 16px;
    color: rgba(255, 255, 255, 0.8);
  }

  .markdown-details :global(li) {
    margin-bottom: 6px;
  }

  .item-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 28px;
    font-size: 0.85rem;
    color: var(--color-muted);
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 968px) {
    .detail-container {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
