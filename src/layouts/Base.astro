---
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const {
  title = "Omeng's Site — Art Director & Senior Software Engineer",
  description = "Portofolio Design & Digital Art Omeng Creations. Temukan berbagai karya kreatif visual dan arsitektur produk digital di sini.",
  ogImage = '/images/logo-omeng.png',
  canonicalURL = Astro.url.href,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo-omeng.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.url)} />

    <!-- Fonts: Bebas Neue (Display) & Poppins (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- HEADER & NAVBAR (LAYOUT ASLI RESTORASI) -->
    <header>
      <nav class="main-nav" id="mainNavbar">
        <div class="nav-container">
          <!-- Sisi Kiri: Menu Drawer Toggle & Logo Brand -->
          <div class="nav-left">
            <button class="nav-toggle" id="drawerToggle" aria-label="Buka Menu Samping" aria-expanded="false">
              <span class="burger-bar"></span>
              <span class="burger-bar"></span>
              <span class="burger-bar"></span>
            </button>

            <!-- Secondary Drawer Menu -->
            <div class="nav-secondary" id="secondaryMenu" aria-hidden="true">
              <div class="secondary-nav-content">
                <div class="secondary-nav-header">
                  <h3>Omeng Menu</h3>
                  <button class="drawer-close" id="drawerClose" aria-label="Tutup Menu">&times;</button>
                </div>
                <div class="nav-items">
                  <a href="/" class={currentPath === '/' ? 'active' : ''}>
                    <span class="menu-icon">✦</span> Beranda
                  </a>
                  <a href="/myproject" class={currentPath.startsWith('/myproject') ? 'active' : ''}>
                    <span class="menu-icon">📁</span> My Project
                  </a>
                  <a href="/shop" class={currentPath.startsWith('/shop') ? 'active' : ''}>
                    <span class="menu-icon">🛍️</span> Shop
                  </a>
                  <a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>
                    <span class="menu-icon">ℹ️</span> About Us
                  </a>
                  <a href="/#kontak">
                    <span class="menu-icon">✉️</span> Kontak & Kolaborasi
                  </a>
                </div>
              </div>
            </div>

            <!-- Brand Logo Asli -->
            <a href="/" class="nav-brand" aria-label="Beranda Omeng Creations">
              <img src="/images/logo-navbar.png" alt="Omeng logo" class="nav-logo" width="160" height="40" />
            </a>
          </div>

          <!-- Bagian Tengah: Search Bar Bulat Asli -->
          <form class="search-bar" action="/search" method="GET" role="search">
            <div class="search-wrapper">
              <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                name="q"
                placeholder="Cari karya atau produk..."
                class="search-input"
                autocomplete="off"
              />
            </div>
          </form>

          <!-- Sisi Kanan: Menu Navigasi Asli -->
          <div class="nav-right">
            <div class="nav-link">
              <a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a>
              <a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>About Us</a>
              <a href="/shop" class={currentPath.startsWith('/shop') ? 'active' : ''}>Shop</a>
              <a href="/myproject" class={currentPath.startsWith('/myproject') ? 'active' : ''}>My Project</a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- CONTENT SLOT -->
    <main id="main-content">
      <slot />
    </main>

    <!-- FOOTER ASLI -->
    <footer class="site-footer">
      <div class="footer-container">
        <p class="copyright">
          &copy; {new Date().getFullYear()} Omeng Creations. All rights reserved.
        </p>
        <div class="footer-links">
          <a href="/myproject">My Project</a>
          <a href="/shop">Shop</a>
          <a href="/about">About Us</a>
          <a href="#mainNavbar" class="back-top-btn" aria-label="Kembali ke atas">Ke Atas ↑</a>
        </div>
      </div>
    </footer>

    <!-- LIGHTBOX PREVIEW MODAL ASLI (Ditingkatkan) -->
    <div id="projectModal" class="project-modal" aria-hidden="true" role="dialog">
      <div class="modal-backdrop" id="modalBackdrop"></div>
      <div class="modal-container">
        <button class="close-modal" id="modalCloseBtn" aria-label="Tutup Preview">&times;</button>
        <img class="modal-content" id="imgPreview" alt="Project Preview" />
        <div id="modalCaption" class="modal-caption"></div>
      </div>
    </div>

    <!-- Script Native Ringan (< 2KB) untuk Interaksi Navbar & Modal -->
    <script>
      // 1. Sticky Navbar
      const navbar = document.getElementById('mainNavbar');
      if (navbar) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 40) {
            navbar.classList.add('is-sticky');
          } else {
            navbar.classList.remove('is-sticky');
          }
        }, { passive: true });
      }

      // 2. Drawer Menu Toggle
      const drawerToggle = document.getElementById('drawerToggle');
      const drawerClose = document.getElementById('drawerClose');
      const secondaryMenu = document.getElementById('secondaryMenu');

      const toggleDrawer = (isOpen: boolean) => {
        if (!secondaryMenu || !drawerToggle) return;
        if (isOpen) {
          secondaryMenu.classList.add('is-open');
          secondaryMenu.setAttribute('aria-hidden', 'false');
          drawerToggle.setAttribute('aria-expanded', 'true');
        } else {
          secondaryMenu.classList.remove('is-open');
          secondaryMenu.setAttribute('aria-hidden', 'true');
          drawerToggle.setAttribute('aria-expanded', 'false');
        }
      };

      if (drawerToggle && secondaryMenu) {
        drawerToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = !secondaryMenu.classList.contains('is-open');
          toggleDrawer(open);
        });

        if (drawerClose) {
          drawerClose.addEventListener('click', () => toggleDrawer(false));
        }

        document.addEventListener('click', (e) => {
          if (secondaryMenu.classList.contains('is-open') && !secondaryMenu.contains(e.target as Node) && !drawerToggle.contains(e.target as Node)) {
            toggleDrawer(false);
          }
        });
      }

      // 3. Global Lightbox Modal Preview
      const modal = document.getElementById('projectModal');
      const modalImg = document.getElementById('imgPreview') as HTMLImageElement;
      const modalCaption = document.getElementById('modalCaption');
      const modalCloseBtn = document.getElementById('modalCloseBtn');
      const modalBackdrop = document.getElementById('modalBackdrop');

      const openModal = (src: string, caption: string) => {
        if (!modal || !modalImg) return;
        modalImg.src = src;
        if (modalCaption) modalCaption.textContent = caption;
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      const closeModal = () => {
        if (!modal) return;
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };

      if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
      if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal?.classList.contains('active')) {
          closeModal();
        }
      });

      // Delegation for elements with [data-preview]
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('[data-preview]');
        if (target) {
          const img = target.querySelector('img');
          const title = target.getAttribute('data-title') || img?.alt || 'Omeng Creations Preview';
          if (img && img.src) {
            e.preventDefault();
            openModal(img.src, title);
          }
        }
      });
    </script>

    <style>
      /*== NAVBAR STYLING ASLI (DISEMPURNAKAN) */
      .main-nav {
        background-color: var(--color-primary-black);
        padding: 12px 24px;
        position: relative;
        width: 100%;
        transition: all 0.3s ease;
        z-index: 1000;
        border-bottom: 1px solid rgba(255, 192, 203, 0.15);
      }

      .main-nav.is-sticky {
        position: fixed;
        top: 0;
        left: 0;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
        background: rgba(0, 0, 0, 0.95);
        backdrop-filter: blur(10px);
        padding: 8px 24px;
      }

      .nav-container {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 20px;
        position: relative;
      }

      .nav-brand {
        display: flex;
        align-items: center;
      }

      .nav-logo {
        height: 38px;
        width: auto;
        object-fit: contain;
      }

      /* Burger Bar */
      .nav-toggle {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 6px;
        z-index: 101;
      }

      .burger-bar {
        display: block;
        width: 24px;
        height: 3px;
        background-color: var(--color-primary-pink);
        border-radius: 2px;
        transition: transform 0.25s ease, opacity 0.25s ease;
      }

      .nav-toggle:hover .burger-bar {
        background-color: var(--color-accent);
      }

      /* Drawer Menu */
      .nav-secondary {
        position: fixed;
        top: 0;
        left: 0;
        width: 320px;
        height: 100vh;
        background: #0d0d10;
        border-right: 1px solid var(--color-primary-pink);
        padding: 30px;
        transform: translateX(-100%);
        visibility: hidden;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1002;
        box-shadow: 20px 0 50px rgba(0, 0, 0, 0.7);
        display: flex;
        flex-direction: column;
      }

      .nav-secondary.is-open {
        transform: translateX(0);
        visibility: visible;
      }

      .secondary-nav-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(255, 192, 203, 0.2);
      }

      .secondary-nav-header h3 {
        color: var(--color-primary-pink);
        font-family: var(--font-display);
        font-size: 2rem;
        letter-spacing: 0.05em;
      }

      .drawer-close {
        background: none;
        border: none;
        color: #fff;
        font-size: 2rem;
        cursor: pointer;
        line-height: 1;
      }

      .secondary-nav-content .nav-items {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .secondary-nav-content .nav-items a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        color: #ffffff;
        font-weight: 500;
        border-radius: var(--radius-md);
        transition: all 0.2s ease;
      }

      .secondary-nav-content .nav-items a:hover,
      .secondary-nav-content .nav-items a.active {
        background: rgba(255, 105, 180, 0.15);
        color: var(--color-accent);
        transform: translateX(6px);
      }

      /* Search Bar Bulat Asli */
      .search-bar {
        flex: 1;
        max-width: 480px;
        margin: 0 16px;
      }

      .search-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
      }

      .search-icon {
        position: absolute;
        left: 18px;
        color: var(--color-primary-pink);
        pointer-events: none;
      }

      .search-input {
        width: 100%;
        padding: 10px 20px 10px 48px;
        border-radius: var(--radius-pill);
        border: 2px solid rgba(255, 255, 255, 0.7);
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
        font-size: 0.95rem;
        font-family: var(--font-body);
        outline: none;
        transition: all 0.25s ease;
      }

      .search-input::placeholder {
        color: rgba(255, 255, 255, 0.6);
      }

      .search-input:focus {
        border-color: var(--color-accent);
        background: rgba(255, 255, 255, 0.16);
        box-shadow: 0 0 16px rgba(255, 105, 180, 0.3);
      }

      /* Menu Kanan */
      .nav-right .nav-link {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .nav-right .nav-link a {
        color: var(--color-primary-pink);
        font-weight: 500;
        font-size: 0.95rem;
        position: relative;
        padding-bottom: 4px;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
      }

      .nav-right .nav-link a:hover,
      .nav-right .nav-link a.active {
        color: #ffffff;
        border-bottom-color: var(--color-primary-pink);
      }

      /* Footer */
      .site-footer {
        background: var(--color-primary-black);
        border-top: 1px solid var(--color-primary-pink);
        padding: 30px 24px;
        margin-top: auto;
      }

      .footer-container {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .copyright {
        color: var(--color-primary-pink);
        font-size: 0.9rem;
        margin: 0;
        opacity: 0.9;
      }

      .footer-links {
        display: flex;
        gap: 20px;
        align-items: center;
      }

      .footer-links a {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.85rem;
      }

      .footer-links a:hover {
        color: var(--color-accent);
      }

      .back-top-btn {
        color: var(--color-primary-pink) !important;
        font-weight: 600;
      }

      /* Modal Lightbox */
      .project-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 2000;
        align-items: center;
        justify-content: center;
      }

      .project-modal.active {
        display: flex;
      }

      .modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.88);
        backdrop-filter: blur(8px);
      }

      .modal-container {
        position: relative;
        max-width: 90vw;
        max-height: 90vh;
        z-index: 2001;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .modal-content {
        max-width: 85vw;
        max-height: 80vh;
        object-fit: contain;
        border-radius: var(--radius-md);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
      }

      .modal-caption {
        margin-top: 14px;
        color: #ffffff;
        font-size: 1.1rem;
        font-weight: 600;
        font-family: var(--font-display);
        letter-spacing: 0.05em;
        text-align: center;
      }

      .close-modal {
        position: absolute;
        top: -45px;
        right: 0;
        background: none;
        border: none;
        color: #ffffff;
        font-size: 2.5rem;
        cursor: pointer;
        line-height: 1;
        transition: color 0.2s ease;
      }

      .close-modal:hover {
        color: var(--color-accent);
      }

      @media (max-width: 850px) {
        .search-bar {
          max-width: 220px;
        }

        .nav-right .nav-link {
          gap: 16px;
        }
      }

      @media (max-width: 720px) {
        .search-bar {
          display: none;
        }

        .nav-right .nav-link {
          gap: 12px;
          font-size: 0.85rem;
        }
      }
    </style>
  </body>
</html>
