---
interface Props {
  title: string;
  summary: string;
  image: string;
  badges: string[];
  price?: string;
  slug: string;
  link?: string;
}

const {
  title,
  summary,
  image,
  badges,
  price = 'Rp 50.000',
  slug,
  link = '6285777145179',
} = Astro.props;

const cleanWa = link.replace(/[^0-9]/g, '');
const waNumber = cleanWa.startsWith('0') ? '62' + cleanWa.slice(1) : cleanWa;
const waMsg = encodeURIComponent(`Halo Omeng Creations! Saya tertarik untuk memesan produk "${title}". Apakah masih tersedia?`);
const waUrl = `https://wa.me/${waNumber}?text=${waMsg}`;
---

<article class="shop-card">
  <!-- Card Image with Lightbox Preview Trigger -->
  <div class="card-image" data-preview data-title={title}>
    <img src={image} alt={title} loading="lazy" width="400" height="240" />
    <span class="preview-badge" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="11" y1="8" x2="11" y2="14"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
      Preview
    </span>
  </div>

  <!-- Badges -->
  <div class="card-badges">
    {badges.map((badge) => (
      <span class="badge">{badge}</span>
    ))}
  </div>

  <!-- Content & Link to Detail -->
  <div class="card-content">
    <h3>
      <a href={`/karya/${slug}`}>{title}</a>
    </h3>
    <p>{summary}</p>
    <div class="card-footer">
      <div class="price-container">
        <span class="price-label">Harga</span>
        <span class="price-val">{price}</span>
      </div>
      <div class="action-buttons">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="order-wa-btn" aria-label={`Pesan ${title} via WhatsApp`}>
          Pesan
        </a>
        <a href={`/karya/${slug}`} class="view-link" aria-label={`Detail produk ${title}`}>
          Detail →
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .shop-card {
    background: #ffffff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--color-text-dark);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .shop-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
  }

  .card-image {
    height: 210px;
    overflow: hidden;
    position: relative;
    cursor: zoom-in;
    background: #f4f4f6;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .shop-card:hover .card-image img {
    transform: scale(1.06);
  }

  .preview-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.25s ease;
  }

  .card-image:hover .preview-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 16px 20px 0;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--color-accent);
    color: #ffffff;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }

  .card-content {
    padding: 16px 20px 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-content h3 {
    font-family: var(--font-display);
    font-size: 1.85rem;
    line-height: 1.1;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
  }

  .card-content h3 a {
    color: var(--color-text-dark);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-content h3 a:hover {
    color: var(--color-accent);
  }

  .card-content p {
    font-size: 0.92rem;
    color: #555555;
    line-height: 1.55;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    border-top: 1px solid #eeeeee;
    margin-top: auto;
  }

  .price-container {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.72rem;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .price-val {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }

  .action-buttons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .order-wa-btn {
    font-size: 0.8rem;
    font-weight: 700;
    background: #25D366;
    color: #ffffff;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .order-wa-btn:hover {
    background: #1ebc59;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.35);
  }

  .view-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .view-link:hover {
    color: var(--color-accent-hover);
  }
</style>
