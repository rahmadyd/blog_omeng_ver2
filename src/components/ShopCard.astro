---
interface Props {
  title: string;
  summary: string;
  image: string;
  badges: string[];
  price?: string;
  slug: string;
  link?: string;
  index?: string;
}

const {
  title,
  summary,
  image,
  badges,
  price = 'Rp 50.000',
  slug,
  link = '6285777145179',
  index = '01',
} = Astro.props;

const cleanWa = link.replace(/[^0-9]/g, '');
const waNumber = cleanWa.startsWith('0') ? '62' + cleanWa.slice(1) : cleanWa;
const waMsg = encodeURIComponent(`Halo Omeng Creations! Saya tertarik untuk memesan produk "${title}". Apakah masih tersedia?`);
const waUrl = `https://wa.me/${waNumber}?text=${waMsg}`;
---

<article class="shop-card">
  <!-- Top Bar -->
  <div class="card-top-bar">
    <span class="index-num">[SHOP-{index}]</span>
    <span class="stock-badge">Ready Stock</span>
  </div>

  <!-- Card Image with Lightbox Preview Trigger -->
  <div class="card-image-wrap" data-preview data-title={title}>
    <img src={image} alt={title} loading="lazy" width="400" height="260" />
    <div class="image-overlay" aria-hidden="true">
      <span class="preview-pill">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        Quick Preview
      </span>
    </div>
  </div>

  <!-- Badges -->
  <div class="card-badges">
    {badges.map((badge) => (
      <span class="badge">{badge}</span>
    ))}
  </div>

  <!-- Content & Link to Detail -->
  <div class="card-content">
    <h3 class="card-title">
      <a href={`/karya/${slug}`}>{title}</a>
    </h3>
    <p class="card-summary">{summary}</p>

    <div class="card-footer">
      <div class="price-container">
        <span class="price-label">Harga</span>
        <span class="price-val">{price}</span>
      </div>

      <div class="action-buttons">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="order-wa-btn" aria-label={`Pesan ${title} via WhatsApp`}>
          Pesan WA
        </a>
        <a href={`/karya/${slug}`} class="view-link" aria-label={`Detail produk ${title}`}>
          Detail →
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .shop-card {
    background: #ffffff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--color-text-dark);
    box-shadow: var(--shadow-card);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    border: 1px solid var(--color-border-card);
  }

  .shop-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-card-hover);
  }

  .card-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted-dark);
  }

  .index-num {
    color: var(--color-accent);
  }

  .stock-badge {
    color: #15803d;
    background: #dcfce7;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: 0.7rem;
  }

  .card-image-wrap {
    height: 220px;
    overflow: hidden;
    position: relative;
    cursor: zoom-in;
    background: #f1f1f4;
    margin: 0 14px;
    border-radius: var(--radius-md);
  }

  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shop-card:hover .card-image-wrap img {
    transform: scale(1.08);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .card-image-wrap:hover .image-overlay {
    opacity: 1;
  }

  .preview-pill {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transform: translateY(6px);
    transition: transform 0.25s ease;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .card-image-wrap:hover .preview-pill {
    transform: translateY(0);
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 16px 20px 0;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-accent);
    color: #ffffff;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }

  .card-content {
    padding: 14px 20px 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.85rem;
    line-height: 1.05;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
  }

  .card-title a {
    color: var(--color-text-dark);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-summary {
    font-size: 0.92rem;
    color: #555555;
    line-height: 1.55;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    border-top: 1px solid #f0f0f4;
    margin-top: auto;
  }

  .price-container {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.7rem;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }

  .price-val {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }

  .action-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .order-wa-btn {
    font-size: 0.8rem;
    font-weight: 700;
    background: #25D366;
    color: #ffffff;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .order-wa-btn:hover {
    background: #1ebc59;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.35);
  }

  .view-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .view-link:hover {
    color: var(--color-accent-hover);
  }
</style>
