---
interface Props {
  text?: string;
  direction?: 'right' | 'left';
  id?: string;
}

const {
  text = 'OMENG',
  direction = 'right',
  id,
} = Astro.props;

// Repeat text for continuous smooth animation
const repetitions = Array.from({ length: 12 });
---

<div class="marquee-container" id={id} aria-hidden="true">
  <div class={`marquee-content marquee-${direction}`}>
    {repetitions.map(() => (
      <span>{text}</span>
    ))}
    {repetitions.map(() => (
      <span>{text}</span>
    ))}
  </div>
</div>

<style>
  .marquee-container {
    background-color: var(--color-primary-black);
    padding: 24px 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(255, 192, 203, 0.15);
    border-bottom: 1px solid rgba(255, 192, 203, 0.15);
  }

  .marquee-content {
    display: flex;
    width: max-content;
  }

  .marquee-right {
    animation: marquee-right 22s linear infinite;
  }

  .marquee-left {
    animation: marquee-left 22s linear infinite;
  }

  .marquee-content span {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: #ffffff;
    padding-right: clamp(32px, 5vw, 64px);
    letter-spacing: 0.06em;
    user-select: none;
  }

  .marquee-content span:nth-child(even) {
    color: var(--color-primary-pink);
  }
</style>
