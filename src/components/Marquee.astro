---
interface Props {
  text?: string;
  direction?: 'right' | 'left';
  id?: string;
}

const {
  text,
  direction = 'right',
  id,
} = Astro.props;

const defaultItems = [
  'OMENG CREATIONS',
  '✦',
  'GRAPHIC DESIGN & ART',
  '●',
  'ILLUSTRATION',
  '✦',
  'MERCHANDISE',
  '★',
  'VISUAL ATELIER',
  '✦',
];

const items = text ? [text, '✦', text, '✦'] : defaultItems;
---

<div class="marquee-container" id={id} aria-hidden="true">
  <div class={`marquee-content marquee-${direction}`}>
    {items.map((item) => (
      <span class={item === '✦' || item === '●' || item === '★' ? 'symbol' : 'text'}>{item}</span>
    ))}
    {items.map((item) => (
      <span class={item === '✦' || item === '●' || item === '★' ? 'symbol' : 'text'}>{item}</span>
    ))}
  </div>
</div>

<style>
  .marquee-container {
    background-color: var(--color-deep-black);
    padding: 22px 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(255, 192, 203, 0.2);
    border-bottom: 1px solid rgba(255, 192, 203, 0.2);
  }

  .marquee-content {
    display: flex;
    align-items: center;
    width: max-content;
  }

  .marquee-right {
    animation: marquee-right 28s linear infinite;
  }

  .marquee-left {
    animation: marquee-left 28s linear infinite;
  }

  .marquee-content span {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.8vw, 3rem);
    letter-spacing: 0.05em;
    padding-right: clamp(24px, 4vw, 48px);
    user-select: none;
    line-height: 1;
  }

  .marquee-content .text {
    color: #ffffff;
  }

  .marquee-content .symbol {
    color: var(--color-accent);
    font-size: 1.5rem;
  }

  .marquee-content span:nth-child(4n + 1) {
    color: var(--color-primary-pink);
  }
</style>
