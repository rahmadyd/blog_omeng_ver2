---
// Hero Section Split 50/50 — Elevated Graphic Design Studio Aesthetic
---

<section class="hero-section" aria-labelledby="hero-heading">
  <!-- Sisi Kiri: Teks & Filosofi Desain Grafis -->
  <div class="hero-content">
    <div class="studio-badge" aria-label="Omeng Creations Graphic Design Studio">
      <span class="badge-dot"></span>
      <span class="badge-text">GRAPHIC DESIGN &amp; VISUAL ATELIER</span>
    </div>

    <h1 id="hero-heading">
      WELCOME TO <br />
      <span class="brand-highlight">OMENG CREATIONS</span>
    </h1>

    <p class="hero-desc">
      Ruang digital untuk merayakan seni kontras tinggi, ilustrasi berkarakter, dan identitas visual yang berani. Merancang karya grafis yang hidup, bercerita, dan memikat di pandangan pertama.
    </p>

    <!-- Kategori Disiplin Desain Grafis Studio -->
    <div class="discipline-tags" aria-label="Fokus Desain Grafis">
      <span class="disc-tag">✦ Brand Identity</span>
      <span class="disc-tag">✦ Illustration</span>
      <span class="disc-tag">✦ Merchandise</span>
      <span class="disc-tag">✦ Visual Art</span>
    </div>

    <div class="hero-actions">
      <a href="#project" class="btn btn-primary hero-cta">
        Let see the Journey!
        <span class="btn-arrow" aria-hidden="true">↓</span>
      </a>
      <a href="/about" class="btn btn-secondary">
        Tentang Studio ↗
      </a>
    </div>
  </div>

  <!-- Sisi Kanan: Visual Pink Ikonik dengan Putaran Badge & Maskot Interaktif -->
  <div class="hero-visual" aria-label="Visual Interaktif Omeng Creations">
    <!-- Studio Watermark Detail di Sudut Canvas -->
    <div class="visual-corner-tag" aria-hidden="true">
      <span>FIG. 01 — KINETIC LOGO</span>
      <span>ED. 2025</span>
    </div>

    <div class="visual-wrapper">
      <!-- Badge Melingkar Berputar 360 Derajat -->
      <img
        src="/images/logo-circle.png"
        class="rotating-text"
        alt="Omeng Creations Rotating Badge"
        width="460"
        height="460"
      />

      <!-- Gelembung Dialog Reaktif Maskot (Speech Bubble) -->
      <div class="cat-dialog-bubble" id="catBubble" aria-live="polite">
        <span id="catBubbleText">Klik aku! 🐾</span>
      </div>

      <!-- Maskot Kucing Interaktif -->
      <button class="cat-button" id="catBtn" aria-label="Sapa Maskot Kucing Omeng">
        <img
          src="/images/logo-omeng.png"
          class="cat-logo"
          id="catImg"
          alt="Omeng Cat Mascot"
          width="220"
          height="220"
        />
      </button>
    </div>

    <span class="visual-hint" aria-hidden="true">Sentuh atau klik kucing untuk berinteraksi ✨</span>
  </div>
</section>

<script>
  // Script Interaktif Maskot Kucing
  const catBtn = document.getElementById('catBtn');
  const catBubble = document.getElementById('catBubble');
  const catBubbleText = document.getElementById('catBubbleText');
  const catImg = document.getElementById('catImg');

  const quotes = [
    "Meow! 🐾 Siap bikin karya visual berani?",
    "Desain grafis dengan karakter tajam! ⚡",
    "Seni kontras tinggi, ilustrasi berjiwa! 🎨",
    "Merchandise, branding, dan digital art! ✨",
    "Bikin brand kamu tampil beda dari yang lain!",
    "Ada proyek ilustrasi? Mari kita wujudkan! ✉️",
    "Purrr... 🐱 Suka stiker atau merchandise Omeng?",
  ];

  let quoteIndex = 0;
  let bubbleTimeout: any;

  const triggerCatReaction = () => {
    if (!catBubble || !catBubbleText || !catImg) return;

    quoteIndex = (quoteIndex + 1) % quotes.length;
    catBubbleText.textContent = quotes[quoteIndex];

    catBubble.classList.add('visible');
    catImg.classList.add('bounce');

    setTimeout(() => {
      catImg.classList.remove('bounce');
    }, 400);

    clearTimeout(bubbleTimeout);
    bubbleTimeout = setTimeout(() => {
      catBubble.classList.remove('visible');
    }, 3500);
  };

  if (catBtn) {
    catBtn.addEventListener('click', (e) => {
      e.preventDefault();
      triggerCatReaction();
    });
  }
</script>

<style>
  .hero-section {
    display: flex;
    min-height: calc(88vh - var(--header-height));
    width: 100%;
    margin: 0;
    background: var(--color-deep-black);
    position: relative;
    border-bottom: 1px solid rgba(255, 192, 203, 0.2);
  }

  .hero-content {
    width: 50%;
    padding: clamp(40px, 6vw, 96px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    z-index: 2;
  }

  /* Studio Monospace Tag */
  .studio-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--color-primary-pink);
    background: rgba(255, 192, 203, 0.08);
    border: 1px solid rgba(255, 192, 203, 0.22);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: 24px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background-color: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-accent);
  }

  .hero-content h1 {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 7.5vw, 6.4rem);
    color: #ffffff;
    line-height: 0.92;
    letter-spacing: 0.02em;
    margin-bottom: 22px;
  }

  .brand-highlight {
    color: var(--color-primary-pink);
    display: block;
    text-shadow: 0 4px 30px rgba(255, 192, 203, 0.3);
  }

  .hero-desc {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    color: rgba(255, 255, 255, 0.82);
    max-width: 540px;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  /* Discipline Tags */
  .discipline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
  }

  .disc-tag {
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-primary {
    background: var(--color-accent);
    color: #ffffff;
    border: 1px solid var(--color-accent);
    box-shadow: 0 6px 24px rgba(255, 105, 180, 0.38);
  }

  .btn-primary:hover {
    background: #ffffff;
    color: var(--color-deep-black);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.35);
  }

  .btn-secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.28);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-primary-pink);
    color: var(--color-primary-pink);
    transform: translateY(-3px);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .btn-arrow {
    transform: translateY(3px);
  }

  /* Sisi Kanan: Pink Visual */
  .hero-visual {
    width: 50%;
    background-color: var(--color-primary-pink);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  /* Corner Technical Stamp */
  .visual-corner-tag {
    position: absolute;
    top: 24px;
    right: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.45);
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  .visual-wrapper {
    position: relative;
    width: min(80%, 460px);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rotating-text {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: spin 25s linear infinite;
    z-index: 1;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.16));
    pointer-events: none;
  }

  /* Tombol Maskot Kucing */
  .cat-button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .cat-button:focus-visible {
    outline: 3px solid #000000;
    border-radius: 50%;
  }

  .cat-logo {
    width: clamp(140px, 18vw, 220px);
    height: auto;
    animation: flip-cat 8s ease-in-out infinite;
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.28));
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .cat-logo.bounce {
    animation: none;
    transform: scale(1.18) rotate(5deg);
  }

  /* Gelembung Dialog Maskot */
  .cat-dialog-bubble {
    position: absolute;
    top: 6%;
    background: #000000;
    color: #ffffff;
    padding: 10px 18px;
    border-radius: 20px;
    border-bottom-left-radius: 4px;
    font-size: 0.88rem;
    font-weight: 600;
    z-index: 10;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    border: 2px solid var(--color-accent);
    opacity: 0;
    transform: translateY(10px) scale(0.9);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    max-width: 240px;
    text-align: center;
  }

  .cat-dialog-bubble.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .visual-hint {
    margin-top: 18px;
    font-size: 0.8rem;
    color: rgba(0, 0, 0, 0.65);
    font-weight: 500;
    z-index: 2;
  }

  @media (max-width: 900px) {
    .hero-section {
      flex-direction: column-reverse;
      min-height: auto;
    }

    .hero-content {
      width: 100%;
      padding: 50px 24px;
    }

    .hero-visual {
      width: 100%;
      min-height: 400px;
      padding: 40px 20px;
    }

    .visual-wrapper {
      width: min(75%, 320px);
    }
  }
</style>
