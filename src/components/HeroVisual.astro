---
// Hero Section Split 50/50 — Clean & Lifted Layout
---

<section class="hero-section" aria-labelledby="hero-heading">
  <!-- Sisi Kiri: Teks & Filosofi Desain Grafis (Posisi Naik ke Atas Rapi) -->
  <div class="hero-content">
    <div class="studio-badge" aria-label="Omeng Creations Graphic Design Studio">
      <span class="badge-dot"></span>
      <span class="badge-text">GRAPHIC DESIGN &amp; VISUAL ATELIER</span>
    </div>

    <h1 id="hero-heading">
      WELCOME TO <br />
      <span class="brand-highlight">OMENG CREATIONS</span>
    </h1>

    <p class="hero-desc">
      Ruang digital untuk merayakan seni kontras tinggi, ilustrasi berkarakter, dan identitas visual yang berani. Merancang karya grafis yang hidup, bercerita, dan memikat di pandangan pertama.
    </p>

    <!-- Kategori Disiplin Desain Grafis Studio -->
    <div class="discipline-tags" aria-label="Fokus Desain Grafis">
      <span class="disc-tag">✦ Brand Identity</span>
      <span class="disc-tag">✦ Illustration</span>
      <span class="disc-tag">✦ Merchandise</span>
      <span class="disc-tag">✦ Visual Art</span>
    </div>

    <div class="hero-actions">
      <a href="#project" class="btn btn-primary hero-cta">
        Let see the Journey!
        <span class="btn-arrow" aria-hidden="true">↓</span>
      </a>
      <a href="/about" class="btn btn-secondary">
        Tentang Studio ↗
      </a>
    </div>
  </div>

  <!-- Sisi Kanan: Visual Pink Ikonik dengan Putaran Badge & Maskot Kucing Asli (Murni Animasi Flip & Spin) -->
  <div class="hero-visual" aria-hidden="true">
    <div class="visual-wrapper">
      <!-- Badge Melingkar Berputar 360 Derajat -->
      <img
        src="/images/logo-circle.png"
        class="rotating-text"
        alt="Omeng Creations Rotating Badge"
        width="460"
        height="460"
      />

      <!-- Maskot Kucing Asli (Animasi Flip Murni Tanpa Efek Klik) -->
      <img
        src="/images/logo-omeng.png"
        class="cat-logo"
        alt="Omeng Cat Mascot"
        width="220"
        height="220"
      />
    </div>
  </div>
</section>

<style>
  .hero-section {
    display: flex;
    min-height: calc(82vh - var(--header-height));
    width: 100%;
    margin: 0;
    background: var(--color-deep-black);
    position: relative;
    border-bottom: 1px solid rgba(255, 192, 203, 0.2);
    align-items: stretch;
  }

  /* Konten Hero Dinaikkan ke Atas (Tidak Menggantung Kosong di Atas) */
  .hero-content {
    width: 50%;
    padding: clamp(28px, 4.5vh, 48px) clamp(28px, 5vw, 84px) clamp(40px, 6vh, 64px);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    z-index: 2;
  }

  /* Studio Monospace Tag */
  .studio-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--color-primary-pink);
    background: rgba(255, 192, 203, 0.08);
    border: 1px solid rgba(255, 192, 203, 0.22);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: 20px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background-color: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-accent);
  }

  .hero-content h1 {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 7.5vw, 6.4rem);
    color: #ffffff;
    line-height: 0.92;
    letter-spacing: 0.02em;
    margin-bottom: 20px;
  }

  .brand-highlight {
    color: var(--color-primary-pink);
    display: block;
    text-shadow: 0 4px 30px rgba(255, 192, 203, 0.3);
  }

  .hero-desc {
    font-family: var(--font-body);
    font-size: clamp(1.02rem, 1.7vw, 1.18rem);
    color: rgba(255, 255, 255, 0.82);
    max-width: 540px;
    line-height: 1.68;
    margin-bottom: 26px;
  }

  /* Discipline Tags */
  .discipline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 34px;
  }

  .disc-tag {
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-primary {
    background: var(--color-accent);
    color: #ffffff;
    border: 1px solid var(--color-accent);
    box-shadow: 0 6px 24px rgba(255, 105, 180, 0.38);
  }

  .btn-primary:hover {
    background: #ffffff;
    color: var(--color-deep-black);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.35);
  }

  .btn-secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.28);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-primary-pink);
    color: var(--color-primary-pink);
    transform: translateY(-3px);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .btn-arrow {
    transform: translateY(3px);
  }

  /* Sisi Kanan: Pink Visual */
  .hero-visual {
    width: 50%;
    background-color: var(--color-primary-pink);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .visual-wrapper {
    position: relative;
    width: min(82%, 460px);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Animasi Putar Murni Badge */
  .rotating-text {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: spin 25s linear infinite;
    z-index: 1;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.16));
    pointer-events: none;
  }

  /* Animasi Flip Kucing Murni */
  .cat-logo {
    position: absolute;
    width: clamp(140px, 18vw, 220px);
    height: auto;
    z-index: 2;
    animation: flip-cat 8s ease-in-out infinite;
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.28));
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero-section {
      flex-direction: column-reverse;
      min-height: auto;
    }

    .hero-content {
      width: 100%;
      padding: 36px 20px 48px;
    }

    .hero-visual {
      width: 100%;
      min-height: 380px;
      padding: 40px 20px;
    }

    .visual-wrapper {
      width: min(75%, 320px);
    }
  }
</style>
