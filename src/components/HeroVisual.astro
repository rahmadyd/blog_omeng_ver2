---
// Hero Section Split 50/50 dengan Animasi Ikonik Cat Mascot & Interactive Speech Bubbles
---

<section class="hero-section" aria-labelledby="hero-heading">
  <!-- Sisi Kiri: Teks, Status Ketersediaan & Ajakan Bertindak -->
  <div class="hero-content">
    <!-- Status Ketersediaan Kerja Real-time -->
    <div class="availability-badge" aria-label="Status Ketersediaan: Terbuka untuk Proyek">
      <span class="status-pulse"></span>
      <span class="status-text">Tersedia untuk Proyek Q4 &amp; Konsultasi</span>
    </div>

    <h1 id="hero-heading">
      WELCOME to <br />OMENG Creations
    </h1>
    <p>
      Ruang digital untuk merayakan seni kontras. Mengawinkan kepekaan visual seorang <strong class="highlight-pink">Art Director</strong> dengan ketelitian rekayasa perangkat lunak <strong class="highlight-white">15 tahun pengalaman</strong>.
    </p>

    <div class="hero-actions">
      <a href="#project" class="btn btn-primary hero-cta">
        Let see the Journey!
        <span class="btn-arrow" aria-hidden="true">↓</span>
      </a>
      <a href="/about" class="btn btn-secondary">
        Tentang Omeng
      </a>
    </div>
  </div>

  <!-- Sisi Kanan: Visual Pink Ikonik dengan Putaran Badge & Maskot Interaktif -->
  <div class="hero-visual" aria-label="Visual Interaktif Omeng Creations">
    <div class="visual-wrapper">
      <!-- Badge Melingkar Berputar 360 Derajat -->
      <img
        src="/images/logo-circle.png"
        class="rotating-text"
        alt="Omeng Creations Rotating Badge"
        width="450"
        height="450"
      />

      <!-- Gelembung Dialog Reaktif Maskot (Speech Bubble) -->
      <div class="cat-dialog-bubble" id="catBubble" aria-live="polite">
        <span id="catBubbleText">Klik aku! 🐾</span>
      </div>

      <!-- Maskot Kucing Interaktif -->
      <button class="cat-button" id="catBtn" aria-label="Sapa Maskot Kucing Omeng">
        <img
          src="/images/logo-omeng.png"
          class="cat-logo"
          id="catImg"
          alt="Omeng Cat Mascot"
          width="220"
          height="220"
        />
      </button>
    </div>
    <span class="visual-hint" aria-hidden="true">Sentuh atau klik kucing untuk berinteraksi ✨</span>
  </div>
</section>

<script>
  // Script Interaktif Maskot Kucing
  const catBtn = document.getElementById('catBtn');
  const catBubble = document.getElementById('catBubble');
  const catBubbleText = document.getElementById('catBubbleText');
  const catImg = document.getElementById('catImg');

  const quotes = [
    "Meow! 🐾 Siap bikin karya visual berani?",
    "15 tahun merajut kode dan estetika! ⚡",
    "Kontras tinggi, nol bloatware! 🚀",
    "Desain bukan hanya tampilan, tapi cara kerjanya.",
    "Astro 5 + Pure CSS = Kecepatan kilat! ⚡",
    "Ada proyek menantang? Mari kita bahas! ✉️",
    "Purrr... 🐱 Kamu menyukai web ini?",
  ];

  let quoteIndex = 0;
  let bubbleTimeout: any;

  const triggerCatReaction = () => {
    if (!catBubble || !catBubbleText || !catImg) return;

    quoteIndex = (quoteIndex + 1) % quotes.length;
    catBubbleText.textContent = quotes[quoteIndex];

    catBubble.classList.add('visible');
    catImg.classList.add('bounce');

    setTimeout(() => {
      catImg.classList.remove('bounce');
    }, 400);

    clearTimeout(bubbleTimeout);
    bubbleTimeout = setTimeout(() => {
      catBubble.classList.remove('visible');
    }, 3500);
  };

  if (catBtn) {
    catBtn.addEventListener('click', (e) => {
      e.preventDefault();
      triggerCatReaction();
    });
  }
</script>

<style>
  .hero-section {
    display: flex;
    min-height: calc(88vh - var(--header-height));
    width: 100%;
    margin: 0;
    background: var(--color-primary-black);
    position: relative;
    border-bottom: 1px solid rgba(255, 192, 203, 0.2);
  }

  .hero-content {
    width: 50%;
    padding: clamp(40px, 6vw, 100px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    z-index: 2;
  }

  /* Badge Ketersediaan dengan Pulse Hijau */
  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #ffffff;
    background: rgba(37, 211, 102, 0.1);
    border: 1px solid rgba(37, 211, 102, 0.3);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    margin-bottom: 22px;
  }

  .status-pulse {
    width: 8px;
    height: 8px;
    background-color: #25d366;
    border-radius: 50%;
    box-shadow: 0 0 10px #25d366;
    animation: pulse-ring 2s infinite;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 8px rgba(37, 211, 102, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  .hero-content h1 {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 6.2rem);
    color: #ffffff;
    line-height: 0.95;
    letter-spacing: 0.03em;
    margin-bottom: 24px;
  }

  .hero-content p {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: rgba(255, 255, 255, 0.82);
    max-width: 520px;
    line-height: 1.65;
    margin-bottom: 36px;
  }

  .highlight-pink {
    color: var(--color-primary-pink);
    font-weight: 600;
  }

  .highlight-white {
    color: #ffffff;
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #ffffff;
    border: 1px solid var(--color-accent);
    box-shadow: 0 4px 20px rgba(255, 105, 180, 0.35);
  }

  .btn-primary:hover {
    background: #ffffff;
    color: var(--color-primary-black);
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.3);
  }

  .btn-secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-primary-pink);
    color: var(--color-primary-pink);
    transform: translateY(-3px);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .btn-arrow {
    transform: translateY(3px);
  }

  /* Sisi Kanan: Pink Visual */
  .hero-visual {
    width: 50%;
    background-color: var(--color-primary-pink);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .visual-wrapper {
    position: relative;
    width: min(80%, 460px);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rotating-text {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: spin 25s linear infinite;
    z-index: 1;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.15));
    pointer-events: none;
  }

  /* Tombol Maskot Kucing */
  .cat-button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .cat-button:focus-visible {
    outline: 3px solid #000000;
    border-radius: 50%;
  }

  .cat-logo {
    width: clamp(140px, 18vw, 220px);
    height: auto;
    animation: flip-cat 8s ease-in-out infinite;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.28));
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .cat-logo.bounce {
    animation: none;
    transform: scale(1.18) rotate(5deg);
  }

  /* Gelembung Dialog Maskot */
  .cat-dialog-bubble {
    position: absolute;
    top: 6%;
    background: #000000;
    color: #ffffff;
    padding: 10px 18px;
    border-radius: 20px;
    border-bottom-left-radius: 4px;
    font-size: 0.88rem;
    font-weight: 600;
    z-index: 10;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    border: 2px solid var(--color-accent);
    opacity: 0;
    transform: translateY(10px) scale(0.9);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    max-width: 240px;
    text-align: center;
  }

  .cat-dialog-bubble.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .visual-hint {
    margin-top: 18px;
    font-size: 0.8rem;
    color: rgba(0, 0, 0, 0.65);
    font-weight: 500;
    z-index: 2;
  }

  @media (max-width: 900px) {
    .hero-section {
      flex-direction: column-reverse;
      min-height: auto;
    }

    .hero-content {
      width: 100%;
      padding: 50px 24px;
    }

    .hero-visual {
      width: 100%;
      min-height: 400px;
      padding: 40px 20px;
    }

    .visual-wrapper {
      width: min(75%, 320px);
    }
  }
</style>
