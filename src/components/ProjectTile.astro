---
interface Props {
  title: string;
  kind: string;
  role: string;
  year: number;
  summary: string;
  slug: string;
  span?: number;
  color?: string;
  ink?: string;
}

const {
  title,
  kind,
  role,
  year,
  summary,
  slug,
  span = 3,
  color = '#141414',
  ink = '#ffffff',
} = Astro.props;
---

<article
  class={`project-tile span-${span}`}
  style={`--tile-bg: ${color}; --tile-ink: ${ink};`}
>
  <a href={`/karya/${slug}`} class="tile-link" aria-label={`Lihat studi kasus ${title}`}>
    <div class="tile-header">
      <span class="tile-badge">{kind}</span>
      <span class="tile-year">{year}</span>
    </div>

    <div class="tile-content">
      <h3 class="tile-title">{title}</h3>
      <p class="tile-role">{role}</p>
      <p class="tile-summary">{summary}</p>
    </div>

    <div class="tile-footer">
      <span class="tile-cta">
        Baca Studi Kasus
        <span class="arrow-icon" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>

<style>
  .project-tile {
    grid-column: span var(--tile-span, 3);
    background-color: var(--tile-bg);
    color: var(--tile-ink);
    border: 1px solid rgba(255, 192, 203, 0.15);
    border-radius: var(--radius-md);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
  }

  .span-2 {
    --tile-span: 2;
  }

  .span-3 {
    --tile-span: 3;
  }

  .span-4 {
    --tile-span: 4;
  }

  .span-6 {
    --tile-span: 6;
  }

  .project-tile:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 12px 30px rgba(255, 105, 180, 0.12);
  }

  .tile-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(var(--space-md), 3vw, var(--space-lg));
    color: inherit;
    text-decoration: none;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .tile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .tile-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-soft);
    background: rgba(255, 105, 180, 0.1);
    border: 1px solid rgba(255, 105, 180, 0.25);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }

  .tile-year {
    font-size: 0.85rem;
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--muted);
  }

  .tile-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .tile-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: 0.03em;
    color: var(--text);
    margin: 0;
    transition: color 0.2s ease;
  }

  .project-tile:hover .tile-title {
    color: var(--accent);
  }

  .tile-role {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-soft);
    margin-bottom: var(--space-xs);
  }

  .tile-summary {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }

  .tile-footer {
    display: flex;
    align-items: center;
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .tile-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .arrow-icon {
    transition: transform 0.25s ease;
    color: var(--accent);
  }

  .project-tile:hover .arrow-icon {
    transform: translateX(6px);
  }

  @media (max-width: 700px) {
    .project-tile {
      grid-column: span 6 !important;
    }
  }
</style>
