---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ShopCard from '../components/ShopCard.astro';

const semuaKarya = await getCollection('karya');
const shopItems = semuaKarya.filter((item) => item.data.category === 'shop');
---

<Base
  title="Shop | Omeng Creations"
  description="Koleksi produk digital, aset grafis, dan merchandise eksklusif dari Omeng Creations."
>
  <div class="shop-page">
    <section class="shop-page-section">
      <div class="shop-container">
        <!-- Header Halaman Toko Asli -->
        <div class="shop-header">
          <div class="title-area">
            <h1>Omeng's Shop</h1>
            <p>Koleksi produk digital dan merchandise eksklusif siap pesan langsung via WhatsApp.</p>
          </div>

          <!-- Filter Tabs Instan -->
          <div class="filter-tabs" role="tablist" aria-label="Filter Kategori Toko">
            <button class="filter-tab active" data-filter="all" role="tab" aria-selected="true">
              Semua <span class="tab-count">({shopItems.length})</span>
            </button>
            <button class="filter-tab" data-filter="merchandise" role="tab" aria-selected="false">
              Merchandise
            </button>
            <button class="filter-tab" data-filter="digital art" role="tab" aria-selected="false">
              Digital Art &amp; Aset
            </button>
          </div>
        </div>

        <!-- Grid Kartu Toko Asli (Putih & Beresolusi Tinggi) -->
        <div class="cards-grid" id="shopGrid">
          {shopItems.map((s) => {
            const categories = [s.data.kind.toLowerCase(), ...s.data.badges.map(b => b.toLowerCase())].join(' ');
            return (
              <div class="shop-item" data-categories={categories}>
                <ShopCard
                  title={s.data.title}
                  summary={s.data.summary}
                  image={s.data.image}
                  badges={s.data.badges}
                  price={s.data.price}
                  slug={s.slug || s.id}
                  link={s.data.link}
                />
              </div>
            );
          })}
        </div>

        <!-- Empty State jika filter kosong -->
        <div id="filterEmptyShop" class="filter-empty" style="display: none;">
          <p>Belum ada produk dalam kategori ini.</p>
        </div>
      </div>
    </section>
  </div>

  <script>
    // Script Filter Tab Instan Tanpa Reload
    const tabs = document.querySelectorAll('.filter-tab');
    const items = document.querySelectorAll('.shop-item');
    const emptyState = document.getElementById('filterEmptyShop');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.getAttribute('data-filter') || 'all';
        let visibleCount = 0;

        items.forEach((item) => {
          const categories = item.getAttribute('data-categories') || '';
          if (filter === 'all' || categories.includes(filter)) {
            (item as HTMLElement).style.display = '';
            visibleCount++;
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  </script>
</Base>

<style>
  .shop-page {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .shop-page-section {
    padding: 0 24px;
  }

  .shop-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(28px, 4vw, 50px);
    background: var(--color-primary-pink);
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 50px rgba(255, 192, 203, 0.15);
  }

  .shop-header {
    margin-bottom: 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .shop-header h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 4.5rem);
    color: #ffffff;
    line-height: 1;
    margin: 0 0 10px 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .shop-header p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
  }

  /* Filter Tabs */
  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .filter-tab {
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #000000;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-tab:hover {
    background: rgba(255, 255, 255, 0.7);
    transform: translateY(-2px);
  }

  .filter-tab.active {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .tab-count {
    font-size: 0.8rem;
    opacity: 0.8;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .shop-item {
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .filter-empty {
    text-align: center;
    padding: 50px 20px;
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 500;
  }

  @media (max-width: 1100px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }

    .shop-container {
      padding: 24px 16px;
      border-radius: var(--radius-lg);
    }
  }
</style>
