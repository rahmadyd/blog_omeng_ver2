---
import Base from '../layouts/Base.astro';

const timeline = [
  {
    period: '2021 — Sekarang',
    role: 'Principal Art Director & Engineering Advisor',
    org: 'Konsultan Independen / Omeng Studio',
    desc: 'Membimbing tim produk digital, memimpin transisi arsitektur frontend skala besar, dan menyusun design system multi-platform.',
  },
  {
    period: '2016 — 2021',
    role: 'Lead Front-End Architect & Creative Technologist',
    org: 'Fintech & Digital Venture Studio',
    desc: 'Merancang arsitektur aplikasi finansial dengan latensi ultra-rendah dan kepatuhan aksesibilitas perbankan.',
  },
  {
    period: '2011 — 2016',
    role: 'Senior Fullstack Engineer & Visual Designer',
    org: 'Digital Agency & Brand Studio',
    desc: 'Mengeksekusi lebih dari 40 proyek web interaktif, platform e-commerce kustom, dan identitas digital korporat.',
  },
  {
    period: '2009 — 2011',
    role: 'Web Developer & Digital Artist',
    org: 'Awal Perjalanan Kreatif',
    desc: 'Membangun aplikasi web generasi awal sembari mengeksplorasi ilustrasi digital dan seni grafis editorial.',
  },
];
---

<Base
  title="About Us | Omeng Creations"
  description="Rumah bagi asset visual berkualitas tinggi dan rekayasa perangkat lunak berdaya tahan tinggi."
>
  <div class="about-page">
    <div class="about-container">
      <!-- Container Pink Khas Halaman About Asli -->
      <div class="project-container">
        <!-- Section Header About Asli -->
        <div class="project-header-about">
          <div class="title-area-about">
            <h2>About Us</h2>
          </div>

          <div class="about-content">
            <p class="description">
              Rumah bagi aset visual berkualitas tinggi dan rekayasa perangkat lunak berkinerja tinggi. Kami fokus menciptakan ilustrasi, sistem desain, dan produk digital yang unik untuk membantu kreator serta bisnis mempercantik dan memperkuat ekosistem digital mereka.
            </p>

            <!-- Mission & Vision Cards Asli -->
            <div class="mission-vision">
              <div class="mission-item">
                <h3>Creative Project</h3>
                <p>Menampilkan kurasi karya terbaik mulai dari identitas branding hingga digital painting dan editorial art berkarakter kuat.</p>
              </div>

              <div class="mission-item">
                <h3>Digital Assets</h3>
                <p>Aset gambar dan komponen antarmuka siap pakai dengan lisensi komersial penuh untuk kebutuhan desain dan pengembangan webmu.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 15 Tahun Perjalanan & Disiplin -->
        <div class="story-container">
          <div class="story-header">
            <h3>Dua Disiplin, Satu Visi: 15 Tahun Pengalaman</h3>
            <p>
              Sebagai Art Director sekaligus Software Engineer, saya menolak kompromi antara keindahan visual dan performa kode. Setiap karya dirancang agar memikat mata sekaligus ringan, cepat, dan mudah diakses di segala perangkat.
            </p>
          </div>

          <div class="timeline-list">
            {timeline.map((item) => (
              <div class="timeline-card">
                <span class="timeline-year">{item.period}</span>
                <div class="timeline-info">
                  <h4>{item.role}</h4>
                  <span class="timeline-org">{item.org}</span>
                  <p>{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="cv-download-bar">
            <span>Perlu dokumen resume resmi?</span>
            <a href="mailto:halo@omeng.dev?subject=Permintaan%20CV%20Omeng" class="btn-cv">
              Hubungi untuk Salinan Resume (PDF) ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .about-page {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .about-container {
    padding: 0 24px;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .project-container {
    background: var(--color-primary-pink);
    border-radius: var(--radius-xl);
    padding: clamp(28px, 4vw, 50px);
    box-shadow: 0 20px 50px rgba(255, 192, 203, 0.15);
  }

  /* Header Box Putih Asli */
  .project-header-about {
    background: #ffffff;
    padding: clamp(30px, 4vw, 50px);
    border-radius: var(--radius-lg);
    margin-bottom: 40px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  .title-area-about h2 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 4.5rem);
    color: var(--color-primary-black);
    line-height: 1;
    margin-bottom: 16px;
    letter-spacing: 0.03em;
  }

  .about-content .description {
    font-size: 1.15rem;
    color: #333333;
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 800px;
  }

  /* Mission & Vision Cards Asli */
  .mission-vision {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .mission-item {
    background: rgba(0, 0, 0, 0.04);
    padding: 28px;
    border-radius: var(--radius-md);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .mission-item h3 {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-accent);
    margin-bottom: 10px;
    letter-spacing: 0.03em;
  }

  .mission-item p {
    font-size: 0.95rem;
    color: #444444;
    line-height: 1.6;
    margin: 0;
  }

  /* Story & Timeline */
  .story-container {
    background: #0d0d11;
    border-radius: var(--radius-lg);
    padding: clamp(30px, 4vw, 50px);
    color: #ffffff;
    border: 1px solid rgba(255, 192, 203, 0.2);
  }

  .story-header h3 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    color: var(--color-primary-pink);
    margin-bottom: 14px;
    letter-spacing: 0.03em;
  }

  .story-header p {
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 750px;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 36px;
  }

  .timeline-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 20px;
    align-items: start;
  }

  .timeline-year {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .timeline-info h4 {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .timeline-org {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-primary-pink);
    margin-bottom: 8px;
  }

  .timeline-info p {
    font-size: 0.92rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }

  .cv-download-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
    gap: 16px;
  }

  .cv-download-bar span {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .btn-cv {
    background: var(--color-accent);
    color: #ffffff;
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-cv:hover {
    background: #ffffff;
    color: #000000;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .mission-vision {
      grid-template-columns: 1fr;
    }

    .timeline-card {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
