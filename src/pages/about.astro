---
import Base from '../layouts/Base.astro';

const creativeMilestones = [
  {
    period: '2023 — Sekarang',
    role: 'Lead Visual Designer & Illustrator',
    org: 'Omeng Creations Atelier',
    desc: 'Mengembangkan koleksi merchandise eksklusif, digital asset library berlisensi komersial, serta identitas visual brand independen.',
  },
  {
    period: '2021 — 2023',
    role: 'Senior Graphic & Brand Designer',
    org: 'Creative Brand Studio',
    desc: 'Merancang visual identity, pedoman brand, kemasan produk fisik, dan eksplorasi tipografi untuk jenama retail modern.',
  },
  {
    period: '2018 — 2021',
    role: 'Digital Illustrator & Concept Artist',
    org: 'Digital Art Collective',
    desc: 'Menghasilkan ratusan karya ilustrasi editorial, artwork karakter, dan eksplorasi tekstur seni grafis kontemporer.',
  },
  {
    period: '2016 — 2018',
    role: 'Junior Graphic Designer',
    org: 'Awal Eksplorasi Visual',
    desc: 'Mempelajari seni tata letak cetak, cetak sablon merchandise, serta estetika visual kontras tinggi.',
  },
];

const designTools = [
  {
    category: 'Desain Grafis & Vektor',
    items: ['Adobe Illustrator', 'Figma', 'Vector Layout', 'Typography Tuning'],
  },
  {
    category: 'Ilustrasi & Digital Painting',
    items: ['Adobe Photoshop', 'Procreate', 'Custom Brushes', 'Paper Texture Blend'],
  },
  {
    category: 'Produksi Merchandise & Cetak',
    items: ['Die-Cut Vinyl Stickers', 'Enamel Pin Crafting', 'Screen Printing', 'Color Separation'],
  },
];
---

<Base
  title="About Us | Omeng Creations Graphic Design"
  description="Rumah bagi aset visual berkualitas tinggi, ilustrasi berkarakter, dan karya desain grafis Omeng Creations."
>
  <div class="about-page">
    <div class="about-container">
      <!-- Container Pink Khas Halaman About Asli -->
      <div class="project-container">
        <!-- Section Header About Box Putih Asli -->
        <div class="project-header-about">
          <div class="title-area-about">
            <span class="about-tag-mono">[ ABOUT OMENG CREATIONS ]</span>
            <h2>About Us</h2>
          </div>

          <div class="about-content">
            <p class="description">
              Rumah bagi eksplorasi seni visual berkualitas tinggi. Omeng Creations lahir dari kecintaan mendalam pada desain grafis bertenaga, ilustrasi berkarakter tajam, dan estetika kontras tinggi yang tak terlupakan.
            </p>
            <p class="description sub-text">
              Kami berfokus menciptakan ilustrasi orisinal, sistem identitas brand yang berkarakter, serta koleksi merchandise fisik yang membawa karya seni digital ke dalam kehidupan sehari-hari.
            </p>

            <!-- Mission & Vision Cards Asli -->
            <div class="mission-vision">
              <div class="mission-item">
                <span class="item-tag">DISIPLIN 01</span>
                <h3>Creative Project</h3>
                <p>Menampilkan kurasi karya terbaik mulai dari desain identitas brand, poster editorial, hingga seni digital ilustrasi bernarasi mendalam.</p>
              </div>

              <div class="mission-item">
                <span class="item-tag">DISIPLIN 02</span>
                <h3>Digital Assets &amp; Merch</h3>
                <p>Aset visual siap pakai dengan lisensi komersial dan lini merchandise eksklusif: stiker vinyl waterproof, enamel pin, dan art prints.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Perjalanan Kreatif & Tools Desain Grafis -->
        <div class="story-container">
          <div class="story-header">
            <h3>Alat &amp; Ekosistem Kreatif Kami</h3>
            <p>
              Setiap karya digambar dan disempurnakan dengan standar visual terbaik, memadukan sentuhan organik gambar tangan dengan ketelitian presisi vektor modern.
            </p>
          </div>

          <!-- Grid Tools Desain Grafis -->
          <div class="tools-grid">
            {designTools.map((t) => (
              <div class="tool-card">
                <h4>{t.category}</h4>
                <ul>
                  {t.items.map((item) => (
                    <li>✦ {item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <!-- Timeline Perjalanan Kreatif -->
          <div class="timeline-section">
            <h4 class="timeline-heading">Jejak Perjalanan Kreatif</h4>
            <div class="timeline-list">
              {creativeMilestones.map((item) => (
                <div class="timeline-card">
                  <span class="timeline-year">{item.period}</span>
                  <div class="timeline-info">
                    <h5>{item.role}</h5>
                    <span class="timeline-org">{item.org}</span>
                    <p>{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="cv-download-bar">
            <span>Tertarik berkolaborasi untuk proyek ilustrasi atau branding?</span>
            <a href="mailto:halo@omeng.dev?subject=Kolaborasi%20Desain%20Grafis%20Omeng" class="btn-cv">
              Mari Berkolaborasi (Kirim Email) ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .about-page {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .about-container {
    padding: 0 24px;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .project-container {
    background: var(--color-primary-pink);
    border-radius: var(--radius-xl);
    padding: clamp(28px, 4vw, 50px);
    box-shadow: var(--shadow-pink-glow);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  /* Header Box Putih Asli */
  .project-header-about {
    background: #ffffff;
    padding: clamp(30px, 4vw, 50px);
    border-radius: var(--radius-lg);
    margin-bottom: 40px;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border-card);
  }

  .about-tag-mono {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 6px;
  }

  .title-area-about h2 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 4.5rem);
    color: var(--color-primary-black);
    line-height: 1;
    margin-bottom: 16px;
    letter-spacing: 0.03em;
  }

  .about-content .description {
    font-size: 1.15rem;
    color: #222224;
    line-height: 1.7;
    margin-bottom: 14px;
    max-width: 840px;
  }

  .about-content .sub-text {
    font-size: 1.05rem;
    color: #55555c;
    margin-bottom: 36px;
  }

  /* Mission & Vision Cards Asli */
  .mission-vision {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .mission-item {
    background: #f7f7fa;
    padding: 28px;
    border-radius: var(--radius-md);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .item-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-muted-dark);
    letter-spacing: 0.06em;
    margin-bottom: 6px;
  }

  .mission-item h3 {
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--color-accent);
    margin-bottom: 8px;
    letter-spacing: 0.03em;
  }

  .mission-item p {
    font-size: 0.95rem;
    color: #444444;
    line-height: 1.6;
    margin: 0;
  }

  /* Story & Timeline */
  .story-container {
    background: #0c0c10;
    border-radius: var(--radius-lg);
    padding: clamp(30px, 4vw, 50px);
    color: #ffffff;
    border: 1px solid rgba(255, 192, 203, 0.2);
  }

  .story-header h3 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    color: var(--color-primary-pink);
    margin-bottom: 14px;
    letter-spacing: 0.03em;
  }

  .story-header p {
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 750px;
  }

  /* Tools Grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 44px;
  }

  .tool-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 22px;
  }

  .tool-card h4 {
    font-size: 1.05rem;
    color: var(--color-primary-pink);
    margin-bottom: 14px;
    font-weight: 600;
  }

  .tool-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tool-card li {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  /* Timeline */
  .timeline-section {
    margin-bottom: 36px;
  }

  .timeline-heading {
    font-family: var(--font-display);
    font-size: 2rem;
    color: #ffffff;
    margin-bottom: 20px;
    letter-spacing: 0.03em;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .timeline-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 20px;
    align-items: start;
  }

  .timeline-year {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .timeline-info h5 {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .timeline-org {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-primary-pink);
    margin-bottom: 8px;
  }

  .timeline-info p {
    font-size: 0.92rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }

  .cv-download-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
    gap: 16px;
  }

  .cv-download-bar span {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .btn-cv {
    background: var(--color-accent);
    color: #ffffff;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-cv:hover {
    background: #ffffff;
    color: #000000;
    transform: translateY(-2px);
  }

  @media (max-width: 850px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }

    .mission-vision {
      grid-template-columns: 1fr;
    }

    .timeline-card {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
